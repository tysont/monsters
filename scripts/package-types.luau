--!nocheck
-- Makes Wally package types visible to luau-lsp. Wally's link files (Packages/Name.lua) only
-- `return require(...)`, which passes values through but not exported types. This rewrites each
-- link to also re-export the package's `export type` declarations:
--
--   local REQUIRED_MODULE = require(script.Parent._Index["owner_pkg@1.0.0"]["pkg"])
--   export type Value<T, S = T> = REQUIRED_MODULE.Value<T, S>
--   return REQUIRED_MODULE
--
-- Run after `wally install` (make packages does). Handles single-line type declarations in the
-- package's entry module, which covers the packages we use.

local fs = require("@lune/fs")
local serde = require("@lune/serde")

local ROOTS = { "Packages", "ServerPackages" }

-- "T, S = T" -> "T, S" (drop defaults, keep packs like "T...").
local function paramNames(params: string): string
	local names = {}
	local depth = 0
	local current = ""
	for i = 1, #params do
		local ch = string.sub(params, i, i)
		if ch == "<" or ch == "(" or ch == "{" then
			depth += 1
		elseif ch == ">" or ch == ")" or ch == "}" then
			depth -= 1
		end
		if ch == "," and depth == 0 then
			table.insert(names, current)
			current = ""
		else
			current ..= ch
		end
	end
	table.insert(names, current)
	for i, name in names do
		names[i] = string.match(string.gsub(name, "=.*$", ""), "^%s*(.-)%s*$")
	end
	return table.concat(names, ", ")
end

local function entryFile(packageDir: string): string?
	local projectPath = `{packageDir}/default.project.json`
	local base = packageDir
	if fs.isFile(projectPath) then
		local project = serde.decode("json", fs.readFile(projectPath))
		local path = project.tree and project.tree["$path"]
		if type(path) == "string" then
			base = `{packageDir}/{path}`
		end
	end
	if fs.isFile(base) then
		return base
	end
	for _, name in { "init.luau", "init.lua" } do
		if fs.isFile(`{base}/{name}`) then
			return `{base}/{name}`
		end
	end
	return nil
end

local updated = 0
for _, root in ROOTS do
	if fs.isDir(root) then
		for _, file in fs.readDir(root) do
			local linkPath = `{root}/{file}`
			if fs.isFile(linkPath) and (string.sub(file, -4) == ".lua" or string.sub(file, -5) == ".luau") then
				local source = fs.readFile(linkPath)
				local index, name = string.match(source, 'script%.Parent%._Index%["([^"]+)"%]%["([^"]+)"%]')
				if index then
					local entry = entryFile(`{root}/_Index/{index}/{name}`)
					if entry then
						local lines = {
							"-- Generated by scripts/package-types.luau (re-exports package types for luau-lsp).",
							`local REQUIRED_MODULE = require(script.Parent._Index["{index}"]["{name}"])`,
						}
						for line in string.gmatch(fs.readFile(entry), "[^\n]+") do
							local typeName, params = string.match(line, "^export type ([%w_]+)%s*<(.-)>%s*=")
							if typeName then
								-- A default naming a type private to the package (Fusion's
								-- `Scope<Constructors = Fusion>`) becomes the module's own type.
								local declared = string.gsub(params, "=%s*([%a_][%w_]*)%s*$", function(default)
									if string.find(source, "export type " .. default, 1, true) then
										return "= " .. default
									end
									return "= typeof(REQUIRED_MODULE)"
								end)
								table.insert(
									lines,
									`export type {typeName}<{declared}> = REQUIRED_MODULE.{typeName}<{paramNames(params)}>`
								)
							else
								typeName = string.match(line, "^export type ([%w_]+)%s*=")
								if typeName then
									table.insert(lines, `export type {typeName} = REQUIRED_MODULE.{typeName}`)
								end
							end
						end
						table.insert(lines, "return REQUIRED_MODULE")
						fs.writeFile(linkPath, table.concat(lines, "\n") .. "\n")
						updated += 1
					else
						print(`package-types: no entry module for {linkPath}`)
					end
				end
			end
		end
	end
end
print(`package-types: updated {updated} link file(s)`)
